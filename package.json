{
  "name": "cafe-stock",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "bun --cwd=frontend x svelte-kit sync && ln -sfn ../frontend/node_modules/\\$app node_modules/\\$app",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter frontend build",
    "start": "bun run --filter backend start",
    "test": "bun run --filter backend test",
    "check": "bun run --filter '*' check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~5.9"
  }
}
