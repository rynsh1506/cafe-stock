{
  "name": "cafe-stock",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "bun --cwd=frontend x svelte-kit sync && ln -sfn ../frontend/node_modules/\\$app node_modules/\\$app",
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun --env-file=../.env --cwd=backend --watch index.ts",
    "dev:frontend": "bun --env-file=../.env --cwd=frontend run dev",
    "build:frontend": "bun run --filter frontend build",
    "build:backend": "bun build backend/index.ts --target bun --outfile backend/dist/index.js",
    "build": "bun run build:frontend && bun run build:backend",
    "docker:build": "mkdir -p ~/.cache/tmp && TMPDIR=$HOME/.cache/tmp docker compose build",
    "docker:up": "mkdir -p ~/.cache/tmp && TMPDIR=$HOME/.cache/tmp docker compose up --build -d",
    "docker:dev": "mkdir -p ~/.cache/tmp && TMPDIR=$HOME/.cache/tmp docker compose up --build",
    "docker:standalone": "mkdir -p data && docker run --rm -it -p 3000:3000 -v $(pwd)/data:/app/data cafe-stock-app",
    "docker:prune": "docker builder prune -a -f && docker image prune -f",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "start": "bun --env-file=../.env --cwd=backend index.ts",
    "db:generate": "bun --env-file=../.env --cwd=backend run db:generate",
    "db:migrate": "bun --env-file=../.env --cwd=backend src/db/migrate.ts",
    "db:seed": "bun --env-file=../.env --cwd=backend src/db/seed.ts",
    "test": "bun run --filter backend test",
    "check": "bun run --filter '*' check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~5.9"
  }
}
