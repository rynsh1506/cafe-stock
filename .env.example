# Server Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
AUTO_MIGRATE=true

# PostgreSQL Database Credentials (Required by docker-compose.yml)
POSTGRES_USER=cafestock_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=cafestock_db
POSTGRES_PORT=5432

# Drizzle / Application Database Connection URL
DATABASE_URL=postgresql://cafestock_user:change_me_in_local_env@localhost:5432/cafestock_db

# Initial Seeder Accounts (Optional overrides)
SEED_USER_EMAIL=staff@cafestock.com
SEED_USER_PASSWORD=User123!
SEED_APPROVER_EMAIL=approver@cafestock.com
SEED_APPROVER_PASSWORD=Approver123!
