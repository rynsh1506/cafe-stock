# ==============================================================================
# CafeStock - Environment Variables Template
# Copy this file to .env and configure your environment-specific values.
# IMPORTANT: Never commit the .env file with real credentials to version control!
# ==============================================================================

# Application Server
PORT=3000
HOST=0.0.0.0

# Database Engine: 'mysql' for Docker / Production, 'sqlite' for Local Standalone
DB_TYPE=mysql

# MySQL Connection Details (Used by App and docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cafe_stock
DB_USER=cafe_user
DB_PASSWORD=cafe_secure_password
DB_ROOT_PASSWORD=root_super_secure_password

# External Host Port Binding for MySQL Container
DB_EXTERNAL_PORT=3306

# SQLite Database Filepath (Only used when DB_TYPE=sqlite)
SQLITE_DB_PATH=database/cafe_stock.sqlite
